# Development only. Generate POSTGRES_PASSWORD with python scripts/init_env.py.
# Production must explicitly use APP_ENV=production, HTTPS and COOKIE_SECURE=true.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
POSTGRES_DB=eduproject
POSTGRES_USER=eduproject
POSTGRES_PASSWORD=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
